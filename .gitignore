# Environment variables (Cực kỳ quan trọng để bảo mật)
.env
fire_detection/web_app/.env

# Virtual Environment (Thư mục ảo chứa thư viện cài thêm)
.venv/
venv/
ENV/

# Python Cache (Bộ nhớ đệm Python)
